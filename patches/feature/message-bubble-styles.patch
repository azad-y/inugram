         public boolean invalidatePath(Rect bounds, boolean drawFullBottom, boolean drawFullTop) {
             boolean inu_tails = desu.inugram.InuConfig.BUBBLE_TAILS.getValue();
-            boolean invalidate = lastRect.isEmpty() || lastRect.top != bounds.top || lastRect.bottom != bounds.bottom || lastRect.right != bounds.right || lastRect.left != bounds.left || lastDrawFullTop != drawFullTop || lastDrawFullBottom != drawFullBottom || !drawFullTop || !drawFullBottom || inu_lastTails != inu_tails;
+            int inu_style = desu.inugram.helpers.chat.BubbleStyleHelper.styleKey();
+            boolean invalidate = inu_lastPathStyle != inu_style || lastRect.isEmpty() || lastRect.top != bounds.top || lastRect.bottom != bounds.bottom || lastRect.right != bounds.right || lastRect.left != bounds.left || lastDrawFullTop != drawFullTop || lastDrawFullBottom != drawFullBottom || !drawFullTop || !drawFullBottom || inu_lastTails != inu_tails;
             lastDrawFullTop = drawFullTop;
             lastDrawFullBottom = drawFullBottom;
             lastRect.set(bounds);
             inu_lastTails = inu_tails;
+            inu_lastPathStyle = inu_style;
             return invalidate;
         }
 

+                } else if (inu_hasIosTail) {
+                    path.moveTo(bounds.left + dp(8) + rad, bounds.bottom - padding);
                 } else {
                     path.moveTo(bounds.left + dp(2.6f), bounds.bottom - padding);
                 }
@@ -857,6 +895,8 @@ public class MessageDrawable extends Drawable {
                         path.lineTo(bounds.left + dp(8), bounds.bottom - padding - radToUse);

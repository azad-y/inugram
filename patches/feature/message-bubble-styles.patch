+    // draws the side edge, the hooked tail and the return to the bottom edge; dir is 1 for outgoing
+    private void inu_iosTail(Path path, float edge, float bottom, int rad, int dir) {
+        path.lineTo(edge, bottom - rad);
+        path.cubicTo(edge, bottom - rad * .5f, edge + dir * dp(1), bottom - dp(3), edge + dir * dp(5.5f), bottom);
+        path.cubicTo(edge + dir * dp(2), bottom + dp(.5f), edge - dir * dp(2.5f), bottom, edge - dir * dp(5), bottom - dp(2.5f));
+        path.cubicTo(edge - dir * dp(8), bottom - dp(.8f), edge - dir * rad * .65f, bottom, edge - dir * rad, bottom);
+    }
+
     private void generatePath(Path path, Rect bounds, int padding, int rad, int smallRad, int nearRad, int top, boolean drawFullBottom, boolean drawFullTop, boolean customPaint) {
         path.rewind();
         int heightHalf = (bounds.height() - padding) >> 1;
         if (rad > heightHalf) {
             rad = heightHalf;
         }
+        boolean inu_ios = desu.inugram.helpers.chat.BubbleStyleHelper.isIos();
+        if (inu_ios && nearRad > heightHalf) {
+            nearRad = heightHalf;
+        }
+        boolean inu_hasIosTail = inu_ios && currentType == TYPE_TEXT && desu.inugram.InuConfig.BUBBLE_TAILS.getValue();
         if (isOut) {
             // LEFT-BOTTOM <- RIGHT-BOTTOM
             if (drawFullBubble || currentType == TYPE_PREVIEW || customPaint || drawFullBottom) {
@@ -736,6 +768,8 @@ public class MessageDrawable extends Drawable {
                     path.moveTo(bounds.right - dp(8) - radToUse, bounds.bottom - padding);
                 } else if (!desu.inugram.InuConfig.BUBBLE_TAILS.getValue()) {
                     path.moveTo(bounds.right - dp(8) - (isBottomNear ? nearRad : rad), bounds.bottom - padding);
+                } else if (inu_hasIosTail) {
+                    path.moveTo(bounds.right - dp(8) - rad, bounds.bottom - padding);
                 } else {
                     path.moveTo(bounds.right - dp(2.6f), bounds.bottom - padding);
                 }
@@ -791,6 +825,8 @@ public class MessageDrawable extends Drawable {
                         path.lineTo(bounds.right - dp(8), bounds.bottom - padding - radToUse);
                         rect.set(bounds.right - dp(8) - radToUse * 2, bounds.bottom - padding - radToUse * 2, bounds.right - dp(8), bounds.bottom - padding);
                         path.arcTo(rect, 0, 90, false);
+                    } else if (inu_hasIosTail) {

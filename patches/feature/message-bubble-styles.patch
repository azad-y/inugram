From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Inugram <dev@inugram.local>
Date: Thu, 26 Nov 2026 19:00:00 +0330
Subject: [PATCH] Add iOS-style and rounded message bubble options

---
 .../telegram/ui/ActionBar/MessageDrawable.java | 40 ++++++++++++++++++++------
 1 file changed, 31 insertions(+), 9 deletions(-)

diff --git a/TMessagesProj/src/main/java/org/telegram/ui/ActionBar/MessageDrawable.java b/TMessagesProj/src/main/java/org/telegram/ui/ActionBar/MessageDrawable.java
--- a/TMessagesProj/src/main/java/org/telegram/ui/ActionBar/MessageDrawable.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/ActionBar/MessageDrawable.java
@@ -334,9 +334,27 @@ private int dp(float value) {
     private int dp(float value) {
         if (currentType == TYPE_PREVIEW) {
             return (int) Math.ceil(3 * value);
         } else {
             return AndroidUtilities.dp(value);
         }
     }
+    private int inuBubbleRadius() {
+        int radius = desu.inugram.InuConfig.IOS_MESSAGE_BUBBLES.getValue() ? 18 : SharedConfig.bubbleRadius;
+        if (desu.inugram.InuConfig.ROUNDED_MESSAGE_BUBBLES.getValue()) {
+            radius += 3;
+        }
+        return dp(Math.min(radius, 22));
+    }
+    private int inuBubbleNearRadius() {
+        int radius = desu.inugram.InuConfig.IOS_MESSAGE_BUBBLES.getValue() ? 7 : 6;
+        if (desu.inugram.InuConfig.ROUNDED_MESSAGE_BUBBLES.getValue()) {
+            radius += 2;
+        }
+        int maxRadius = desu.inugram.InuConfig.IOS_MESSAGE_BUBBLES.getValue() ? 18 : SharedConfig.bubbleRadius;
+        if (desu.inugram.InuConfig.ROUNDED_MESSAGE_BUBBLES.getValue()) {
+            maxRadius += 3;
+        }
+        return dp(Math.min(radius, Math.min(maxRadius, 22)));
+    }
 
     public Paint getPaint() {
@@ -356,5 +374,5 @@ public class MessageDrawable extends Drawable {
         } else if (overrideRounding > 0) {
             newRad = 0;
         } else {
-            newRad = dp(SharedConfig.bubbleRadius);
+            newRad = inuBubbleRadius();
         }
@@ -490,1 +508,1 @@
-        int newRad = dp(SharedConfig.bubbleRadius);
+        int newRad = inuBubbleRadius();
@@ -600,5 +618,5 @@ public class MessageDrawable extends Drawable {
         } else {
-            rad = dp(SharedConfig.bubbleRadius);
-            nearRad = dp(Math.min(6, SharedConfig.bubbleRadius));
+            rad = inuBubbleRadius();
+            nearRad = inuBubbleNearRadius();
         }
-        int smallRad = dp(6);
+        int smallRad = dp(desu.inugram.InuConfig.IOS_MESSAGE_BUBBLES.getValue() ? 7 : desu.inugram.InuConfig.ROUNDED_MESSAGE_BUBBLES.getValue() ? 8 : 6);
@@ -650,5 +668,5 @@ public class MessageDrawable extends Drawable {
         } else {
-            rad = dp(SharedConfig.bubbleRadius);
-            nearRad = dp(Math.min(6, SharedConfig.bubbleRadius));
+            rad = inuBubbleRadius();
+            nearRad = inuBubbleNearRadius();
         }
-        int smallRad = dp(6);
+        int smallRad = dp(desu.inugram.InuConfig.IOS_MESSAGE_BUBBLES.getValue() ? 7 : desu.inugram.InuConfig.ROUNDED_MESSAGE_BUBBLES.getValue() ? 8 : 6);
@@ -929,14 +947,20 @@ public static class PathDrawParams {
         Rect lastRect = new Rect();
         boolean lastDrawFullTop;
         boolean lastDrawFullBottom;
         boolean inu_lastTails = true;
+        boolean inuLastIosStyle;
+        boolean inuLastRounded;
 
         public boolean invalidatePath(Rect bounds, boolean drawFullBottom, boolean drawFullTop) {
             boolean inu_tails = desu.inugram.InuConfig.BUBBLE_TAILS.getValue();
-            boolean invalidate = lastRect.isEmpty() || lastRect.top != bounds.top || lastRect.bottom != bounds.bottom || lastRect.right != bounds.right || lastRect.left != bounds.left || lastDrawFullTop != drawFullTop || lastDrawFullBottom != drawFullBottom || !drawFullTop || !drawFullBottom || inu_lastTails != inu_tails;
+            boolean inuIosStyle = desu.inugram.InuConfig.IOS_MESSAGE_BUBBLES.getValue();
+            boolean inuRounded = desu.inugram.InuConfig.ROUNDED_MESSAGE_BUBBLES.getValue();
+            boolean invalidate = lastRect.isEmpty() || lastRect.top != bounds.top || lastRect.bottom != bounds.bottom || lastRect.right != bounds.right || lastRect.left != bounds.left || lastDrawFullTop != drawFullTop || lastDrawFullBottom != drawFullBottom || !drawFullTop || !drawFullBottom || inu_lastTails != inu_tails || inuLastIosStyle != inuIosStyle || inuLastRounded != inuRounded;
             lastDrawFullTop = drawFullTop;
             lastDrawFullBottom = drawFullBottom;
             inu_lastTails = inu_tails;
+            inuLastIosStyle = inuIosStyle;
+            inuLastRounded = inuRounded;
             lastRect.set(bounds);
             return invalidate;
         }

+    private boolean shouldHideMessageReactions(MessageObject messageObject) {
+        if (messageObject == null || messageObject.messageOwner == null) {
+            return false;
+        }
+        if (messageObject.messageOwner.reply_to != null
+                && (messageObject.messageOwner.reply_to.reply_to_msg_id != 0
+                || messageObject.messageOwner.reply_to.reply_to_top_id != 0
+                || messageObject.messageOwner.reply_to.reply_to_random_id != 0)) {
+            return desu.inugram.InuConfig.HIDE_REACTIONS_COMMENTS.getValue();
+        }
+        long dialogId = messageObject.getDialogId();
+        if (dialogId > 0) {
+            return desu.inugram.InuConfig.HIDE_REACTIONS_MESSAGES.getValue();
+        }
+        TLRPC.Chat chat = MessagesController.getInstance(currentAccount).getChat(-dialogId);
+        if (org.telegram.messenger.ChatObject.isChannelAndNotMegaGroup(chat)) {
+            return desu.inugram.InuConfig.HIDE_REACTIONS_CHANNEL_POSTS.getValue();
+        }
+        return desu.inugram.InuConfig.HIDE_REACTIONS_MESSAGES.getValue();
+    }
